+++ b/app/routers/task_dependencies.py
@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from ..db import get_db
+from ..deps import get_current_user, require_project_access
+from ..models import Project, Task, TaskDependency, User
+from ..schemas import TaskDependencyCreate
+
+router = APIRouter(tags=["task-dependencies"])
+
+
+def _serialize(dep: TaskDependency) -> dict:
+    return {
+        "id": dep.id,
+        "predecessor_task_id": dep.predecessor_task_id,
+        "successor_task_id": dep.successor_task_id,
+        "dependency_type": dep.dependency_type.value,
+        "lag_days": dep.lag_days,
+    }
+
+
+def _project_for_task(task: Task, db: Session) -> Project:
+    project = db.get(Project, task.project_id)
+    if not project:
+        raise HTTPException(status_code=404, detail="Projeto não encontrado")
+    return project
+
+
+@router.post("/task-dependencies", status_code=status.HTTP_201_CREATED)
+def create_dependency(data: TaskDependencyCreate, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    predecessor = db.get(Task, data.predecessor_task_id)
+    successor = db.get(Task, data.successor_task_id)
+    if not predecessor or not successor:
+        raise HTTPException(status_code=404, detail="Tarefa predecessora ou sucessora não encontrada")
+    if predecessor.project_id != successor.project_id:
+        raise HTTPException(status_code=422, detail="Predecessora e sucessora precisam pertencer ao mesmo projeto")
+    if predecessor.id == successor.id:
+        raise HTTPException(status_code=422, detail="Uma tarefa não pode depender de si mesma")
+    project = _project_for_task(predecessor, db)
+    require_project_access(project, user, write=True)
+    if db.scalar(
+        select(TaskDependency).where(
+            TaskDependency.predecessor_task_id == predecessor.id,
+            TaskDependency.successor_task_id == successor.id,
+        )
+    ):
+        raise HTTPException(status_code=409, detail="Essa dependência já existe")
+    dependency = TaskDependency(**data.model_dump())
+    db.add(dependency)
+    db.commit()
+    db.refresh(dependency)
+    return _serialize(dependency)
+
+
+@router.get("/tasks/{task_id}/dependencies")
+def list_dependencies(task_id: str, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    task = db.get(Task, task_id)
+    if not task:
+        raise HTTPException(status_code=404, detail="Tarefa não encontrada")
+    project = _project_for_task(task, db)
+    require_project_access(project, user)
+    deps = db.scalars(
+        select(TaskDependency).where(
+            (TaskDependency.predecessor_task_id == task_id) | (TaskDependency.successor_task_id == task_id)
+        )
+    ).all()
+    return [_serialize(d) for d in deps]
+
+
+@router.delete("/task-dependencies/{dependency_id}", status_code=status.HTTP_204_NO_CONTENT)
+def delete_dependency(dependency_id: str, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    dependency = db.get(TaskDependency, dependency_id)
+    if not dependency:
+        raise HTTPException(status_code=404, detail="Dependência não encontrada")
+    predecessor = db.get(Task, dependency.predecessor_task_id)
+    project = _project_for_task(predecessor, db)
+    require_project_access(project, user, write=True)
+    db.delete(dependency)
+    db.commit()
