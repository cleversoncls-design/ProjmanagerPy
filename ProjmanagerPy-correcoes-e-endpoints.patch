+def recalc_task_actual_hours(session: Session, task_id: str) -> Decimal:
+    """Recalcula Task.actual_hours como a soma dos timesheets aprovados da tarefa.
+
+    Timesheets PENDING/REJECTED não contam como horas realizadas; só a aprovação
+    de um apontamento deve mover a tarefa. Chamar sempre que um timesheet mudar
+    de status (aprovar/rejeitar/reverter) para manter o campo consistente.
+    """
+    task = session.get(Task, task_id)
+    if not task:
+        raise ValueError("Tarefa não encontrada")
+    total = session.scalar(
+        select(func.sum(Timesheet.hours_spent)).where(
+            Timesheet.task_id == task_id, Timesheet.status == TimesheetStatus.APPROVED
+        )
+    )
+    task.actual_hours = Decimal(total) if total is not None else Decimal("0")
+    session.flush()
+    return task.actual_hours
