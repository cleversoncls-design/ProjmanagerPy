+++ b/scripts/configurar_porta_3035.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+# Configura o ambiente para expor a API na porta 3035, cria o .env quando
+# necessário, valida a senha do PostgreSQL, valida o docker-compose.yml e
+# executa o build. Na primeira execução, interrompe antes do
+# `docker compose up` para que a senha padrão seja trocada.
+set -euo pipefail
+
+cd "$(dirname "${BASH_SOURCE[0]}")/.."
+
+ENV_FILE=".env"
+ENV_EXAMPLE=".env.example"
+DEFAULT_PASSWORD="troque-esta-senha"
+
+if [ ! -f "$ENV_FILE" ]; then
+    if [ ! -f "$ENV_EXAMPLE" ]; then
+        echo "Erro: $ENV_EXAMPLE não encontrado." >&2
+        exit 1
+    fi
+    cp "$ENV_EXAMPLE" "$ENV_FILE"
+    echo "Arquivo $ENV_FILE criado a partir de $ENV_EXAMPLE."
+    echo "Edite $ENV_FILE e defina uma senha forte em POSTGRES_PASSWORD antes de continuar."
+    echo "Execute este script novamente depois de trocar a senha."
+    exit 0
+fi
+
+# shellcheck disable=SC1090
+set -a
+source "$ENV_FILE"
+set +a
+
+if [ -z "${POSTGRES_PASSWORD:-}" ] || [ "${POSTGRES_PASSWORD}" = "$DEFAULT_PASSWORD" ]; then
+    echo "Erro: defina uma senha forte em POSTGRES_PASSWORD dentro de $ENV_FILE (valor padrão ainda em uso)." >&2
+    exit 1
+fi
+
+if ! grep -q '^API_PORT=' "$ENV_FILE"; then
+    echo "API_PORT=3035" >> "$ENV_FILE"
+    echo "API_PORT=3035 adicionado a $ENV_FILE."
+else
+    sed -i.bak 's/^API_PORT=.*/API_PORT=3035/' "$ENV_FILE" && rm -f "$ENV_FILE.bak"
+fi
+
+echo "Validando docker-compose.yml..."
+docker compose config >/dev/null
+
+echo "Construindo as imagens..."
+docker compose build
+
+echo "Configuração concluída. Para subir os serviços, execute:"
+echo "  docker compose up -d"
