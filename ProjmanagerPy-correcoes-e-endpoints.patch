@@ -0,0 +1,58 @@
+import pytest
+from fastapi import HTTPException
+from sqlalchemy import create_engine
+from sqlalchemy.orm import Session
+
+from app.deps import require_project_access
+from app.models import Base, Client, Project, User, UserRole
+
+
+def session():
+    engine = create_engine("sqlite:///:memory:")
+    Base.metadata.create_all(engine)
+    return Session(engine)
+
+
+def _make_project_and_users(db):
+    client_a = Client(code="CLI-A", legal_name="Cliente A")
+    client_b = Client(code="CLI-B", legal_name="Cliente B")
+    pm = User(name="PM", email="pm@example.com", password_hash="x", role=UserRole.INTERNAL_PM)
+    db.add_all([client_a, client_b, pm])
+    db.flush()
+    project = Project(client_id=client_a.id, manager_id=pm.id, code="PRJ-A", name="Projeto A")
+    db.add(project)
+    db.flush()
+    client_pm = User(name="Cliente PM", email="client-pm@example.com", password_hash="x", role=UserRole.CLIENT_PM, client_id=client_a.id)
+    client_user = User(name="Cliente User", email="client-user@example.com", password_hash="x", role=UserRole.CLIENT_USER, client_id=client_a.id)
+    outsider = User(name="Outro cliente", email="outsider@example.com", password_hash="x", role=UserRole.CLIENT_PM, client_id=client_b.id)
+    db.add_all([client_pm, client_user, outsider])
+    db.commit()
+    return project, client_pm, client_user, outsider
+
+
+def test_client_user_cannot_write_within_own_project():
+    db = session()
+    project, client_pm, client_user, outsider = _make_project_and_users(db)
+    # Leitura é permitida para CLIENT_USER dentro do próprio escopo.
+    require_project_access(project, client_user, write=False)
+    # Escrita não é permitida para CLIENT_USER — este é o bug corrigido:
+    # antes, essa checagem nunca disparava porque a condição testava um
+    # papel que já havia sido confirmado como pertencente ao conjunto oposto.
+    with pytest.raises(HTTPException) as exc:
+        require_project_access(project, client_user, write=True)
+    assert exc.value.status_code == 403
+
+
+def test_client_pm_can_write_within_own_scope():
+    db = session()
+    project, client_pm, client_user, outsider = _make_project_and_users(db)
+    # CLIENT_PM pode escrever dentro do próprio cliente.
+    require_project_access(project, client_pm, write=True)
+
+
+def test_external_user_cannot_access_project_of_another_client():
+    db = session()
+    project, client_pm, client_user, outsider = _make_project_and_users(db)
+    with pytest.raises(HTTPException) as exc:
+        require_project_access(project, outsider, write=False)
+    assert exc.value.status_code == 403
