+++ b/app/routers/tasks.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from ..db import get_db
+from ..deps import get_current_user, require_project_access
+from ..models import Calendar, Project, Task, User
+from ..schemas import TaskCreate, TaskUpdate
+from ..services import BusinessCalendar, calendar_from_db, reschedule_cascade
+
+router = APIRouter(tags=["tasks"])
+
+
+def _serialize(task: Task) -> dict:
+    return {
+        "id": task.id,
+        "project_id": task.project_id,
+        "parent_task_id": task.parent_task_id,
+        "name": task.name,
+        "wbs_code": task.wbs_code,
+        "estimated_hours": task.estimated_hours,
+        "actual_hours": task.actual_hours,
+        "planned_start_date": task.planned_start_date,
+        "planned_end_date": task.planned_end_date,
+        "actual_start_date": task.actual_start_date,
+        "actual_end_date": task.actual_end_date,
+        "progress_percentage": task.progress_percentage,
+        "status": task.status.value,
+        "is_critical_path": task.is_critical_path,
+        "is_milestone": task.is_milestone,
+    }
+
+
+def _get_project_or_404(project_id: str, db: Session) -> Project:
+    project = db.get(Project, project_id)
+    if not project:
+        raise HTTPException(status_code=404, detail="Projeto não encontrado")
+    return project
+
+
+@router.post("/projects/{project_id}/tasks", status_code=status.HTTP_201_CREATED)
+def create_task(project_id: str, data: TaskCreate, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    project = _get_project_or_404(project_id, db)
+    require_project_access(project, user, write=True)
+    if db.scalar(select(Task).where(Task.project_id == project_id, Task.wbs_code == data.wbs_code)):
+        raise HTTPException(status_code=409, detail="Já existe uma tarefa com esse código WBS neste projeto")
+    if data.parent_task_id:
+        parent = db.get(Task, data.parent_task_id)
+        if not parent or parent.project_id != project_id:
+            raise HTTPException(status_code=422, detail="parent_task_id precisa ser uma tarefa existente do mesmo projeto")
+    task = Task(project_id=project_id, **data.model_dump())
+    db.add(task)
+    db.commit()
+    db.refresh(task)
+    return _serialize(task)
+
+
+@router.get("/projects/{project_id}/tasks")
+def list_tasks(project_id: str, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    project = _get_project_or_404(project_id, db)
+    require_project_access(project, user)
+    tasks = db.scalars(select(Task).where(Task.project_id == project_id).order_by(Task.wbs_code)).all()
+    return [_serialize(t) for t in tasks]
+
+
+@router.patch("/tasks/{task_id}")
+def update_task(task_id: str, data: TaskUpdate, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    task = db.get(Task, task_id)
+    if not task:
+        raise HTTPException(status_code=404, detail="Tarefa não encontrada")
+    project = _get_project_or_404(task.project_id, db)
+    require_project_access(project, user, write=True)
+    for field, value in data.model_dump(exclude_unset=True).items():
+        setattr(task, field, value)
+    db.commit()
+    db.refresh(task)
+    return _serialize(task)
+
+
+@router.post("/tasks/{task_id}/reschedule")
+def reschedule_task(task_id: str, calendar_id: str | None = None, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    task = db.get(Task, task_id)
+    if not task:
+        raise HTTPException(status_code=404, detail="Tarefa não encontrada")
+    project = _get_project_or_404(task.project_id, db)
+    require_project_access(project, user, write=True)
+    if calendar_id:
+        if not db.get(Calendar, calendar_id):
+            raise HTTPException(status_code=404, detail="Calendário não encontrado")
+        cal = calendar_from_db(db, calendar_id)
+    else:
+        cal = BusinessCalendar()
+    try:
+        updated = reschedule_cascade(db, task_id, cal)
+    except ValueError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from exc
+    db.commit()
+    return {"updated_tasks": [_serialize(t) for t in updated]}
