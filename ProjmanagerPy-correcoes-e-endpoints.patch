+++ b/app/routers/users.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Header, HTTPException, status
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+from ..db import get_db
+from ..deps import EXTERNAL_ROLES, get_current_user, require_role
+from ..models import Client, User, UserRole, UserStatus
+from ..schemas import LoginRequest, UserCreate, UserUpdate
+from ..security import hash_password, verify_password
+
+router = APIRouter(tags=["users"])
+
+
+def _serialize(user: User) -> dict:
+    return {
+        "id": user.id,
+        "name": user.name,
+        "email": user.email,
+        "role": user.role.value,
+        "status": user.status.value,
+        "client_id": user.client_id,
+    }
+
+
+@router.post("/users", status_code=status.HTTP_201_CREATED)
+def create_user(data: UserCreate, db: Session = Depends(get_db), x_user_id: Annotated[str | None, Header()] = None):
+    # Bootstrap: o primeiro usuário do sistema pode ser criado sem autenticação
+    # (não há como logar sem nenhum usuário existente). A partir do segundo
+    # usuário, só um ADMIN autenticado pode cadastrar novos usuários.
+    existing_count = db.scalar(select(func.count()).select_from(User)) or 0
+    if existing_count > 0:
+        if not x_user_id:
+            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Credencial ausente")
+        actor = db.get(User, x_user_id)
+        if not actor or actor.status != UserStatus.ACTIVE:
+            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Usuário inválido ou inativo")
+        if actor.role != UserRole.ADMIN:
+            raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="Apenas ADMIN pode criar usuários")
+    elif data.role != UserRole.ADMIN:
+        raise HTTPException(status_code=status.HTTP_422_UNPROCESSABLE_ENTITY, detail="O primeiro usuário do sistema precisa ser ADMIN")
+
+    if db.scalar(select(User).where(User.email == data.email)):
+        raise HTTPException(status_code=409, detail="E-mail já cadastrado")
+    if data.role in EXTERNAL_ROLES and not data.client_id:
+        raise HTTPException(status_code=422, detail="client_id é obrigatório para perfis de cliente")
+    if data.client_id and not db.get(Client, data.client_id):
+        raise HTTPException(status_code=422, detail="client_id não corresponde a um cliente existente")
+
+    user = User(
+        name=data.name,
+        email=data.email,
+        password_hash=hash_password(data.password),
+        role=data.role,
+        client_id=data.client_id,
+    )
+    db.add(user)
+    db.commit()
+    db.refresh(user)
+    return _serialize(user)
+
+
+@router.post("/auth/login")
+def login(data: LoginRequest, db: Session = Depends(get_db)):
+    user = db.scalar(select(User).where(User.email == data.email))
+    if not user or user.status != UserStatus.ACTIVE or not verify_password(data.password, user.password_hash):
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="E-mail ou senha inválidos")
+    # Demonstrativo: retorna o próprio id do usuário para uso no header X-User-Id.
+    # Antes de produção, substituir por um JWT assinado com expiração.
+    return {"user_id": user.id, "role": user.role.value}
+
+
+@router.get("/users/me")
+def read_me(user: User = Depends(get_current_user)):
+    return _serialize(user)
+
+
+@router.get("/users")
+def list_users(user: User = Depends(require_role(UserRole.ADMIN)), db: Session = Depends(get_db)):
+    users = db.scalars(select(User).order_by(User.name)).all()
+    return [_serialize(u) for u in users]
+
+
+@router.patch("/users/{user_id}")
+def update_user(user_id: str, data: UserUpdate, user: User = Depends(require_role(UserRole.ADMIN)), db: Session = Depends(get_db)):
+    target = db.get(User, user_id)
+    if not target:
+        raise HTTPException(status_code=404, detail="Usuário não encontrado")
+    for field, value in data.model_dump(exclude_unset=True).items():
+        setattr(target, field, value)
+    db.commit()
+    db.refresh(target)
+    return _serialize(target)
