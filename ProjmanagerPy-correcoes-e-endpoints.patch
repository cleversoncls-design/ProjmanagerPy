@@ -0,0 +1,93 @@
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from ..db import get_db
+from ..deps import INTERNAL_ROLES, get_current_user, require_project_access, require_role
+from ..models import Project, Resource, Task, Timesheet, TimesheetStatus, User
+from ..schemas import TimesheetCreate
+from ..services import recalc_task_actual_hours
+
+router = APIRouter(tags=["timesheets"])
+
+
+def _serialize(entry: Timesheet) -> dict:
+    return {
+        "id": entry.id,
+        "task_id": entry.task_id,
+        "resource_id": entry.resource_id,
+        "date": entry.date,
+        "hours_spent": entry.hours_spent,
+        "description": entry.description,
+        "status": entry.status.value,
+    }
+
+
+@router.post("/timesheets", status_code=status.HTTP_201_CREATED)
+def create_timesheet(data: TimesheetCreate, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    task = db.get(Task, data.task_id)
+    if not task:
+        raise HTTPException(status_code=404, detail="Tarefa não encontrada")
+    project = db.get(Project, task.project_id)
+    require_project_access(project, user, write=True)
+    resource = db.scalar(select(Resource).where(Resource.user_id == user.id))
+    if not resource:
+        raise HTTPException(status_code=422, detail="Usuário não possui recurso habilitado")
+    entry = Timesheet(task_id=task.id, resource_id=resource.id, date=data.date, hours_spent=data.hours_spent, description=data.description)
+    db.add(entry)
+    db.commit()
+    db.refresh(entry)
+    return _serialize(entry)
+
+
+@router.get("/timesheets")
+def list_timesheets(
+    project_id: str | None = None,
+    resource_id: str | None = None,
+    status_filter: TimesheetStatus | None = None,
+    user: User = Depends(get_current_user),
+    db: Session = Depends(get_db),
+):
+    query = select(Timesheet)
+    if project_id:
+        query = query.join(Task, Task.id == Timesheet.task_id).where(Task.project_id == project_id)
+        project = db.get(Project, project_id)
+        if not project:
+            raise HTTPException(status_code=404, detail="Projeto não encontrado")
+        require_project_access(project, user)
+    elif user.role not in INTERNAL_ROLES:
+        # Sem project_id, um perfil externo só pode ver os próprios lançamentos.
+        resource = db.scalar(select(Resource).where(Resource.user_id == user.id))
+        query = query.where(Timesheet.resource_id == (resource.id if resource else "__none__"))
+    if resource_id:
+        query = query.where(Timesheet.resource_id == resource_id)
+    if status_filter:
+        query = query.where(Timesheet.status == status_filter)
+    entries = db.scalars(query.order_by(Timesheet.date.desc())).all()
+    return [_serialize(e) for e in entries]
+
+
+def _set_status(timesheet_id: str, new_status: TimesheetStatus, db: Session) -> Timesheet:
+    entry = db.get(Timesheet, timesheet_id)
+    if not entry:
+        raise HTTPException(status_code=404, detail="Lançamento não encontrado")
+    entry.status = new_status
+    db.flush()
+    recalc_task_actual_hours(db, entry.task_id)
+    db.commit()
+    db.refresh(entry)
+    return entry
+
+
+@router.patch("/timesheets/{timesheet_id}/approve")
+def approve_timesheet(timesheet_id: str, user: User = Depends(require_role(*INTERNAL_ROLES)), db: Session = Depends(get_db)):
+    entry = _set_status(timesheet_id, TimesheetStatus.APPROVED, db)
+    return _serialize(entry)
+
+
+@router.patch("/timesheets/{timesheet_id}/reject")
+def reject_timesheet(timesheet_id: str, user: User = Depends(require_role(*INTERNAL_ROLES)), db: Session = Depends(get_db)):
+    entry = _set_status(timesheet_id, TimesheetStatus.REJECTED, db)
+    return _serialize(entry)
