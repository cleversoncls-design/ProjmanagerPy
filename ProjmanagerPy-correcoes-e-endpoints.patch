+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from ..db import get_db
+from ..deps import EXTERNAL_ROLES, INTERNAL_ROLES, get_current_user, require_role
+from ..models import Client, User
+from ..schemas import ClientCreate, ClientUpdate
+
+router = APIRouter(prefix="/clients", tags=["clients"])
+
+
+def _serialize(client: Client) -> dict:
+    return {
+        "id": client.id,
+        "code": client.code,
+        "legal_name": client.legal_name,
+        "trade_name": client.trade_name,
+        "tax_id": client.tax_id,
+        "city": client.city,
+        "state": client.state,
+        "primary_contact_name": client.primary_contact_name,
+        "primary_contact_email": client.primary_contact_email,
+    }
+
+
+@router.post("", status_code=status.HTTP_201_CREATED)
+def create_client(data: ClientCreate, user: User = Depends(require_role(*INTERNAL_ROLES)), db: Session = Depends(get_db)):
+    if db.scalar(select(Client).where(Client.code == data.code)):
+        raise HTTPException(status_code=409, detail="Já existe um cliente com esse código")
+    client = Client(**data.model_dump())
+    db.add(client)
+    db.commit()
+    db.refresh(client)
+    return _serialize(client)
+
+
+@router.get("")
+def list_clients(user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    if user.role in EXTERNAL_ROLES:
+        clients = [db.get(Client, user.client_id)] if user.client_id else []
+        clients = [c for c in clients if c]
+    else:
+        clients = db.scalars(select(Client).order_by(Client.legal_name)).all()
+    return [_serialize(c) for c in clients]
+
+
+@router.get("/{client_id}")
+def read_client(client_id: str, user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    client = db.get(Client, client_id)
+    if not client:
+        raise HTTPException(status_code=404, detail="Cliente não encontrado")
+    if user.role in EXTERNAL_ROLES and user.client_id != client.id:
+        raise HTTPException(status_code=403, detail="Fora do escopo do cliente")
+    return _serialize(client)
+
+
+@router.patch("/{client_id}")
+def update_client(client_id: str, data: ClientUpdate, user: User = Depends(require_role(*INTERNAL_ROLES)), db: Session = Depends(get_db)):
+    client = db.get(Client, client_id)
+    if not client:
+        raise HTTPException(status_code=404, detail="Cliente não encontrado")
+    for field, value in data.model_dump(exclude_unset=True).items():
+        setattr(client, field, value)
+    db.commit()
+    db.refresh(client)
+    return _serialize(client)
