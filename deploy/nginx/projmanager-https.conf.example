# Exemplo opcional: copiar para /etc/nginx/conf.d/projmanager.conf
# Ajuste server_name e os caminhos do certificado interno antes de habilitar.
# O serviço web continua no Docker em 127.0.0.1:3036.

server {
    listen 80;
    server_name projetos.empresa.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name projetos.empresa.local;

    ssl_certificate     /etc/nginx/tls/projetos.empresa.local.crt;
    ssl_certificate_key /etc/nginx/tls/projetos.empresa.local.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    location / {
        proxy_pass http://127.0.0.1:3036;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
