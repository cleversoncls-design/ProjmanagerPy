POSTGRES_DB=projmanager
POSTGRES_USER=projmanager
POSTGRES_PASSWORD=troque-esta-senha
API_PORT=3035

# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
JWT_SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-forte
JWT_EXPIRE_MINUTES=480

# Origens de navegador autorizadas a chamar a API (CORS), separadas por
# vírgula. Deixe vazio (padrão) se só houver consumo servidor-a-servidor.
# Se for usar o frontend (serviço "web" do docker-compose), inclua a
# origem dele aqui — ex., para o IP/porta padrão deste projeto:
# CORS_ORIGINS=http://192.168.22.20:3036,http://localhost:3036
CORS_ORIGINS=

# --- Frontend (serviço "web" do docker-compose) ---

# Porta no host onde o frontend fica acessível.
WEB_PORT=3036

# Endereço em que o NAVEGADOR do usuário alcança a API — não é o endereço
# interno do container ("api:8000"), é o que aparece na barra de endereço
# de quem acessa o sistema. Fica gravado dentro do JS estático no momento
# do build, então trocar este valor exige reconstruir a imagem do
# frontend: docker compose build web && docker compose up -d web
VITE_API_BASE_URL=http://192.168.22.20:3035

# Rate limiting básico (janela deslizante em memória, por IP/token). 0
# (padrão) desativa. Ex.: 100 requisições a cada 60 segundos.
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=60
