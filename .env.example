POSTGRES_DB=projmanager
POSTGRES_USER=projmanager
POSTGRES_PASSWORD=troque-esta-senha
API_PORT=3035

# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
JWT_SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-forte
JWT_EXPIRE_MINUTES=480

# Chave de criptografia da senha de SMTP salva na tela de Configurações >
# E-mail (configurador de envio de e-mail) — sem ela, a API não sobe
# nenhuma funcionalidade de e-mail (agendamento, aprovações pendentes)
# porque não consegue cifrar/decifrar a senha salva. SEPARADA da
# JWT_SECRET_KEY acima — nunca reaproveite a mesma chave para as duas
# coisas. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_CREDENTIALS_ENCRYPTION_KEY=troque-por-uma-chave-fernet-gerada

# Fuso horário dos horários da Agenda de consultores nos convites de calendário
# (.ics). Opcional — o padrão é America/Asuncion.
# APP_TIMEZONE=America/Asuncion

# Origens de navegador autorizadas a chamar a API (CORS), separadas por
# vírgula. Deixe vazio (padrão) — o frontend chama a API por "/api" na
# MESMA origem (nginx repassa internamente, ver frontend/nginx.conf), então
# chamadas de navegador não são mais cross-origin e não precisam de CORS.
# Só preencha isto se algo fora do navegador (outro frontend, script,
# integração) chamar a API diretamente, num domínio diferente.
# Ex.: CORS_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGINS=

# --- Frontend (serviço "web" do docker-compose) ---

# Porta no host onde o frontend fica acessível — é a ÚNICA porta que
# precisa estar liberada no firewall/roteador para acesso externo (a API
# é repassada internamente por ela; API_PORT abaixo continua existindo só
# para acesso direto à API — curl, Swagger — sem passar pelo frontend).
WEB_PORT=3036

# Deixe VAZIA (padrão/recomendado): o frontend chama "/api" no mesmo
# host:porta que o navegador usou pra abrir a página — funciona acessando
# por localhost, IP da rede local ou IP público ao mesmo tempo, sem
# escolher um endereço fixo e sem expor uma segunda porta. Só preencha
# isto se a API morar num host DIFERENTE do frontend (fora deste
# docker-compose). Qualquer mudança aqui é gravada dentro do JS estático no
# momento do build, então exige reconstruir a imagem:
# docker compose build web && docker compose up -d web
VITE_API_BASE_URL=

# Rate limiting básico (janela deslizante em memória, por IP/token). 0
# (padrão) desativa. Ex.: 100 requisições a cada 60 segundos.
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=60
