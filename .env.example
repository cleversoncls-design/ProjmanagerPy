POSTGRES_DB=projmanager
POSTGRES_USER=projmanager
POSTGRES_PASSWORD=troque-esta-senha
API_PORT=3035

# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
JWT_SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-forte
JWT_EXPIRE_MINUTES=480

# Origens de navegador autorizadas a chamar a API (CORS), separadas por
# vírgula — liste TODOS os endereços pelos quais alguém vai abrir o
# frontend (rede local, localhost, IP público, domínio, etc.). Deixe vazio
# (padrão) se só houver consumo servidor-a-servidor.
# Ex.: CORS_ORIGINS=http://192.168.22.20:3036,http://localhost:3036,http://SEU-IP-PUBLICO:3036
CORS_ORIGINS=

# --- Frontend (serviço "web" do docker-compose) ---

# Porta no host onde o frontend fica acessível.
WEB_PORT=3036

# Deixe VAZIA (padrão/recomendado): o frontend descobre sozinho o
# endereço da API a partir do host que o navegador usou pra abrir a
# página (mesma porta de API_PORT acima) — funciona acessando por
# localhost, IP da rede local ou IP público ao mesmo tempo, sem escolher
# um endereço fixo. Só preencha isto se a API morar num host DIFERENTE do
# frontend. Qualquer mudança aqui é gravada dentro do JS estático no
# momento do build, então exige reconstruir a imagem:
# docker compose build web && docker compose up -d web
VITE_API_BASE_URL=

# Rate limiting básico (janela deslizante em memória, por IP/token). 0
# (padrão) desativa. Ex.: 100 requisições a cada 60 segundos.
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=60
